# Supabase Configuration (REQUIRED)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-here

# Site-wide Authentication (REQUIRED - for livestream access control)
SITE_PASSWORD=your-access-code-here

# Admin Panel Authentication (REQUIRED)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password-here

# Flask Session (REQUIRED for production)
FLASK_SECRET_KEY=generate-random-secret-key-here
BEHIND_HTTPS=1

# Locket Account Seed (optional - creates first account if DB is empty)
EMAIL=
PASSWORD=

# RevenueCat Token Fallback (optional)
gist_token_url=

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
